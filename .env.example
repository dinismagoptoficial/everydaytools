# The web port can be changed before the first start.
PORT=80
BIND_ADDRESS=0.0.0.0
FILE_RETENTION_MINUTES=60
MAX_UPLOAD_SIZE=256
MAX_STORAGE_USAGE=10240
MIN_FREE_DISK_SPACE=1024
LIGHT_CONCURRENCY=3
MEDIUM_CONCURRENCY=2
HEAVY_CONCURRENCY=1
WEB_CPUS=0.75
WEB_MEMORY=768m
WORKER_CPUS=2.0
WORKER_MEMORY=3g
PROCESS_MEMORY_MB=2304
PROCESS_THREADS=2
MAX_ACTIVE_JOBS=6
# Empty: calculate scheduling budget from the worker container's memory limit.
PROCESSING_BUDGET_MB=
JOB_TIMEOUT_SECONDS=900
MAX_OUTPUT_MB=1024
MAX_EXTRACT_MB=512
# After setup, editable limits live in SQLite. Change them in Administration.
# HTTPS reverse proxy only:
COOKIE_SECURE=false
TRUSTED_PROXY_IPS=127.0.0.1
# PUBLIC_URL=https://tools.example.org
# Optional SMTP (files are never attached):
# SMTP_HOST=mail.example.org
# SMTP_PORT=587
# SMTP_FROM=tools@example.org
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
